# =========================
# 🌐 FRONTEND (PUBLIC)
# =========================

# Development only: set to your local Python API server.
# Production (Vercel auto deploy on https://bd-cr7.vercel.app):
# leave NEXT_PUBLIC_API_URL EMPTY (or unset). The Next.js API proxy
# (app/api/[...path]/route.ts) reads PYTHON_API_URL server-side.
# Setting this to localhost in Vercel production will break API calls.
NEXT_PUBLIC_API_URL=
# Public direct API base (if client-side direct calls are used).
NEXT_PUBLIC_API_BASE_URL=https://bd-cr7-api.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=replace-with-unsigned-upload-preset


# =========================
# 🔐 BACKEND API PROXY (SERVER-SIDE ONLY)
# =========================

# URL of the Python FastAPI backend.
# This is a SERVER-SIDE variable — it is never sent to the browser.
# The Next.js API proxy (app/api/[...path]/route.ts) forwards all /api/*
# requests from the browser to this URL.
#
# Development:  http://localhost:8000
# Production:   https://bd-cr7-api.onrender.com
#
# NOTE: PYTHON_API_URL takes priority over NEXT_PUBLIC_API_URL for
# server-side proxying.  NEXT_PUBLIC_API_URL is kept for backward
# compatibility in environments that set it.
PYTHON_API_URL=https://bd-cr7-api.onrender.com

# Proxy request timeout in milliseconds (default: 9000 = 9s).
# 9s is conservative for Vercel Hobby (10s function limit).
# Increase for Vercel Pro/Enterprise plans: e.g. 30000 (30s).
# PROXY_TIMEOUT_MS=9000


# =========================
# 🔐 BACKEND (SECRET)
# =========================

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key


# =========================
# 🗄️ DATABASE
# =========================

DATABASE_URL=postgresql+psycopg://postgres:replace-with-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# Optional — used to auto-build DATABASE_URL if not set directly
# SUPABASE_DB_PASSWORD=replace-with-db-password


# =========================
# ⚙️ BACKEND RUNTIME
# =========================

APP_NAME=BD CR7 API Core
APP_ENV=development
LOG_LEVEL=INFO
# Development: http://localhost:3000
# Production:  https://bd-cr7.vercel.app
CORS_ORIGINS=http://localhost:3000,https://bd-cr7.vercel.app
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Governance automation (Render cron)
# Preferred: shared secret calling internal endpoint.
GOVERNANCE_REFRESH_SECRET=replace-with-long-random-secret
# Optional fallback (legacy mode): admin/checker bearer token.
# GOVERNANCE_REFRESH_BEARER_TOKEN=replace-with-bearer-token
# Optional override for API host used by cron job script.
GOVERNANCE_REFRESH_API_URL=https://bd-cr7-api.onrender.com


# =========================
# 📍 GEOFENCE (Construction Attendance)
# =========================
# Centre point of the construction site — used to validate GPS on attendance marking.
# Workers must be within SITE_MAX_RADIUS_KM of this point to mark attendance.
#
# Example below = Dhaka city centre. Replace with your actual site coordinates.
SITE_LAT=23.8103
SITE_LNG=90.4125
SITE_MAX_RADIUS_KM=0.5


# =========================
# 🔁 REDIS (Rate Limiting — required in production)
# =========================

REDIS_URL=redis://localhost:6379/0
# Set to "false" only for local dev or single-worker deployments
REQUIRE_REDIS_IN_PRODUCTION=true
# Set to "false" only if Supabase is intentionally skipped (rare)
REQUIRE_SUPABASE_IN_PRODUCTION=true
