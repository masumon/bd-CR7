# =========================
# 🌐 FRONTEND (PUBLIC)
# =========================

# Development: http://localhost:8000
# Production:  https://bd-cr7.vercel.app  (same domain — Vercel routes /api/* to Python)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key


# =========================
# 🔐 BACKEND (SECRET)
# =========================

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key


# =========================
# 🗄️ DATABASE (USE ONLY ONE)
# =========================

DATABASE_URL=postgresql+psycopg://postgres:replace-with-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# ❌ REMOVE THIS (not needed if DATABASE_URL used)
# SUPABASE_DB_PASSWORD=replace-with-db-password


# =========================
# ⚙️ BACKEND RUNTIME
# =========================

APP_NAME=BD CR7 API Core
APP_ENV=development
LOG_LEVEL=INFO
# Development: http://localhost:3000
# Production:  https://bd-cr7.vercel.app
CORS_ORIGINS=http://localhost:3000,https://bd-cr7.vercel.app
RATE_LIMIT_REQUESTS_PER_MINUTE=60


# =========================
# 🔁 OPTIONAL
# =========================

REQUIRE_SUPABASE_IN_PRODUCTION=false
REQUIRE_REDIS_IN_PRODUCTION=false
REDIS_URL=redis://localhost:6379/0