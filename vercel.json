{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": ["api/**", "apps/api/**", "requirements.txt", "runtime.txt"]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/apps/web"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/main.py"
    },
    {
      "source": "/:path*",
      "destination": "/apps/web/:path*"
    }
  ]
}
