{
  "version": 2,
  "framework": "nextjs",
  "outputDirectory": "apps/web-pwa/.next",
  "installCommand": "corepack enable && corepack prepare pnpm@10.17.1 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "NODE_OPTIONS=--no-deprecation pnpm --filter web-pwa build",
  "devCommand": "NODE_OPTIONS=--no-deprecation pnpm --filter web-pwa dev",
  "functions": {
    "api/main.py": {
      "runtime": "python3.11"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/main.py"
    }
  ]
}
