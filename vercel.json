{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter ./apps/web build",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "api/main.py": {
      "runtime": "python3.11",
      "includeFiles": "apps/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/main.py" }
  ]
}